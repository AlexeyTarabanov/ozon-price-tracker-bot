[Unit]
Description=Ozon Price Tracker Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ozonbot
Group=ozonbot
WorkingDirectory=/opt/ozon-price-tracker-bot
Environment=PYTHONUNBUFFERED=1
Environment=OZON_BROWSER_PROFILE_DIR=/opt/ozon-price-tracker-bot/.ozon-browser-profile
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/ozon-price-tracker-bot/.playwright-browsers
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1920x1080x24" /opt/ozon-price-tracker-bot/.venv/bin/python /opt/ozon-price-tracker-bot/main.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
